MELEDiscordRPC.ini (copy next to the .asi file) - all keys optional:

[presence]
; Discord application ID from https://discord.com/developers/applications
client_id=000000000000000000

; 1 = mod active, 0 = off
enabled=1

; 1 = open a debug console window while the game runs; writes %LOCALAPPDATA%\MELEDiscordRPC log regardless
debug=0

; 1 = show raw internal package name instead of "Exploring" for unknown maps
show_raw_packages=1

; 1 = show game number ("Mass Effect 2"), 0 = just "Mass Effect"
show_game_number=1
